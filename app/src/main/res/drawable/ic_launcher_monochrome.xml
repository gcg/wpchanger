    <path android:fillColor="#00000000" android:strokeColor="#FF000000" android:strokeWidth="2.4" android:strokeLineCap="round" android:pathData="M43,45 L65,45" />
    <path android:fillColor="#00000000" android:strokeColor="#FF000000" android:strokeWidth="2.4" android:strokeLineCap="round" android:pathData="M43,63 L65,63" />
</vector>
