<?xml version="1.0" encoding="utf-8"?>
<!--
  Single-color silhouette of ic_launcher_foreground, used for Android 13+ themed
  ("Material You") icons — the system recolors this using the device's wallpaper-based
  accent color, so only the alpha shape matters, not this fill color.

  Season colors carry no meaning here, so the 4 fields become thin divider lines (an X) and
  only the season glyphs + center hourglass remain as solid silhouette shapes.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Quadrant dividers -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="3"
        android:pathData="M0,0 L108,108 M108,0 L0,108" />

    <!-- Spring: cherry blossom -->
    <path android:fillColor="#FF000000" android:pathData="M54,23 m-3.3,0 a3.3,3.3 0,1 1,6.6 0 a3.3,3.3 0,1 1,-6.6 0" />
    <path android:fillColor="#FF000000" android:pathData="M58.8,26.5 m-3.3,0 a3.3,3.3 0,1 1,6.6 0 a3.3,3.3 0,1 1,-6.6 0" />
    <path android:fillColor="#FF000000" android:pathData="M56.9,32.1 m-3.3,0 a3.3,3.3 0,1 1,6.6 0 a3.3,3.3 0,1 1,-6.6 0" />
    <path android:fillColor="#FF000000" android:pathData="M51.1,32.1 m-3.3,0 a3.3,3.3 0,1 1,6.6 0 a3.3,3.3 0,1 1,-6.6 0" />
    <path android:fillColor="#FF000000" android:pathData="M49.2,26.5 m-3.3,0 a3.3,3.3 0,1 1,6.6 0 a3.3,3.3 0,1 1,-6.6 0" />

    <!-- Summer: sun -->
    <path android:fillColor="#FF000000" android:pathData="M80,54 m-7,0 a7,7 0,1 1,14 0 a7,7 0,1 1,-14 0" />
    <group android:pivotX="80" android:pivotY="54" android:rotation="0">
        <path android:fillColor="#00000000" android:strokeColor="#FF000000" android:strokeWidth="2.4" android:strokeLineCap="round" android:pathData="M80,45 L80,41" />
    </group>
    <group android:pivotX="80" android:pivotY="54" android:rotation="45">
        <path android:fillColor="#00000000" android:strokeColor="#FF000000" android:strokeWidth="2.4" android:strokeLineCap="round" android:pathData="M80,45 L80,41" />
    </group>
    <group android:pivotX="80" android:pivotY="54" android:rotation="90">
        <path android:fillColor="#00000000" android:strokeColor="#FF000000" android:strokeWidth="2.4" android:strokeLineCap="round" android:pathData="M80,45 L80,41" />
    </group>
    <group android:pivotX="80" android:pivotY="54" android:rotation="135">
        <path android:fillColor="#00000000" android:strokeColor="#FF000000" android:strokeWidth="2.4" android:strokeLineCap="round" android:pathData="M80,45 L80,41" />
    </group>
    <group android:pivotX="80" android:pivotY="54" android:rotation="180">
        <path android:fillColor="#00000000" android:strokeColor="#FF000000" android:strokeWidth="2.4" android:strokeLineCap="round" android:pathData="M80,45 L80,41" />
    </group>
    <group android:pivotX="80" android:pivotY="54" android:rotation="225">
        <path android:fillColor="#00000000" android:strokeColor="#FF000000" android:strokeWidth="2.4" android:strokeLineCap="round" android:pathData="M80,45 L80,41" />
    </group>
    <group android:pivotX="80" android:pivotY="54" android:rotation="270">
        <path android:fillColor="#00000000" android:strokeColor="#FF000000" android:strokeWidth="2.4" android:strokeLineCap="round" android:pathData="M80,45 L80,41" />
    </group>
    <group android:pivotX="80" android:pivotY="54" android:rotation="315">
        <path android:fillColor="#00000000" android:strokeColor="#FF000000" android:strokeWidth="2.4" android:strokeLineCap="round" android:pathData="M80,45 L80,41" />
    </group>

    <!-- Fall: leaf -->
    <path android:fillColor="#FF000000" android:pathData="M54,72 C59,74 61,79 54,88 C47,79 49,74 54,72 Z" />

    <!-- Winter: snowflake -->
    <group android:pivotX="28" android:pivotY="54" android:rotation="0">
        <path android:fillColor="#00000000" android:strokeColor="#FF000000" android:strokeWidth="2.2" android:strokeLineCap="round" android:pathData="M28,45 L28,63" />
    </group>
    <group android:pivotX="28" android:pivotY="54" android:rotation="60">
