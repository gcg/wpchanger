<?xml version="1.0" encoding="utf-8"?>
<!--
  Single-color silhouette of ic_launcher_foreground, used for Android 13+ themed
  ("Material You") icons — the system recolors this using the device's wallpaper-based
  accent color, so only the alpha shape matters, not this fill color.

  The card is an outline rather than a solid fill: this is one flat alpha channel with
  no color layering, so a solid card would visually swallow the sun/mountains/badge
  drawn "on top" of it (same opaque alpha = no contrast). An outline keeps the interior
  transparent so those shapes stay visible.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Card outline -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="4"
        android:pathData="M35,24 H71 A10,10 0 0 1 81,34 V70 A10,10 0 0 1 71,80 H35 A10,10 0 0 1 25,70 V34 A10,10 0 0 1 35,24 Z" />

    <!-- Sun -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M63,38 m-6,0 a6,6 0,1 1,12 0 a6,6 0,1 1,-12 0" />

    <!-- Mountains -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M31,74 L48,50 L58,62 L70,44 L75,74 Z" />

    <!-- Shuffle badge -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M76,77 m-13,0 a13,13 0,1 1,26 0 a13,13 0,1 1,-26 0" />
</vector>
