<?xml version="1.0" encoding="utf-8"?>
<!-- Status bar icon for the "wallpaper changed" notification. Must be a flat white-on-transparent
     silhouette — the system ignores this color and draws its own tint. Mirrors the launcher
     icon's center hourglass badge. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path android:fillColor="#FFFFFFFF" android:pathData="M6,4 L18,4 L12,12 Z" />
    <path android:fillColor="#FFFFFFFF" android:pathData="M6,20 L18,20 L12,12 Z" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M5,4 L19,4 M5,20 L19,20" />
</vector>
